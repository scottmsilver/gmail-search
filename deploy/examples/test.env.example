# ~/.config/gmail-search/test.env: the disposable test database for
# scripts/test.sh and the issue loop (chmod 600; never commit the real file).
# Never the live database (port 5544): tests/conftest.py and the loop refuse it.
# The file is sourced by bash: quote any value with spaces (a key=value DSN).
GMS_TEST_PG_DSN='postgresql://postgres:CHANGE_ME@127.0.0.1:55440/postgres'
GMS_GATEWAY_TEST_DSN='postgresql://postgres:CHANGE_ME@127.0.0.1:55440/postgres'
