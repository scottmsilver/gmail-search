# Contract template for a new deployment; the running service uses private real values.
# Load the same public origin into Next.js and FastAPI. Omit all GMS_PUBLIC_*
# settings in the private deployment; an empty origin is an error.
GMAIL_MULTI_TENANT=1
GMS_PUBLIC_ORIGIN=https://gms.oursilverfamily.com
GMS_PUBLIC_ALLOWED_EMAILS=REPLACE_WITH_OWNER_EMAIL
GMS_IDENTITY_BROKER_URL=https://identitybroker-ncloonclxa-uc.a.run.app
GMS_IDENTITY_HANDOFF_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
GMS_SESSION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
WEB_CONCURRENCY=1
# Gmail linking is intentionally unavailable in public mode until separately secured.
# One actual Python process is required. Restart revokes all public sessions.

GMAIL_SEARCH_API_URL=http://127.0.0.1:8091
GMAIL_DEEP_REAL=1
# DB_DSN must use the provisioned gmail_search_public role.
# Public API also needs its independent GMAIL_MCP_ADMIN_TOKEN and GEMINI_API_KEY.
